# Container listen ports on EC2 host
WAF_HTTP_PORT=80
WAF_HTTPS_PORT=443

# ModSecurity / CRS tuning
PARANOIA=1
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4
BLOCKING_PARANOIA=1
MODSEC_RULE_ENGINE=On

# Proxy behavior
PROXY=1
BACKEND=http://host.docker.internal:8080

# Logging and timezone
REPORTING_LEVEL=2
TZ=UTC
